
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>

<div id="map" data-places="<%= @places.map { |p| p.as_json.merge(category_name: p.category&.name) }.to_json %>"></div>

<script>
   document.addEventListener("turbo:load", function() {
    const mapEl = document.getElementById("map");
    const places = JSON.parse(mapEl.dataset.places);

    const map = L.map("map").setView([45.748, 4.847], 13);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    // Afficher les marqueurs existants
      const categoryColors = {
    "Loisir":                 "green",
    "Manger":                 "orange",
    "Santé":                  "red",
    "Logement":               "blue",
    "Travail":                "purple",
    "Première nécessité":     "darkred",
    "Vie quotidienne":        "cadetblue",
    "Droit / Papier":         "darkblue",
    "École / Cours de langue":"darkgreen",
    "Solidarité / Soutien":   "pink"
  };

  places.forEach(place => {
    const color = categoryColors[place.category_name] || "grey";
    const icon = L.divIcon({
      className: "",
      html: `<div style="background:${color}; width:24px; height:24px; border-radius:50%; border:2px solid white;"></div>`
    });

    L.marker([place.latitude, place.longitude], { icon })
      .addTo(map)
      .bindPopup(`<strong>${place.title}</strong><br>${place.category_name || ""}`);
  });

  }, { once: true });
</script>
