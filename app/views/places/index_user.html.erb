  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1>Mes places</h1>
      <%= link_to "Ajouter un lieu", new_place_path, class: "btn btn-primary" %>
    </div>

    <% if @places.empty? %>
      <p>Tu n'as pas encore ajouté de lieu.</p>
    <% else %>
      <ul class="list-group">
        <% @places.each do |place| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong><%= place.title %></strong>
              <% if place.content.present? %>
                <p class="mb-0 text-muted"><%= place.content %></p>
              <% end %>
            </div>
            <%= button_to "Supprimer", place_path(place), method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "Supprimer ce lieu ?" } %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
